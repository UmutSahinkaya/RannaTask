@model List<RannaTask.WEB.Models.AdminUserViewModel>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container mt-4">
    <h2><i class="bi bi-people"></i> Kullanıcı Yönetimi</h2>
    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Henüz kullanıcı bulunmamaktadır.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Kullanıcı Adı</th>
                        <th>Email</th>
                        <th>Ad Soyad</th>
                        <th>Rol</th>
                        <th>Durum</th>
                        <th>Kayıt Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.OrderByDescending(u => u.Created))
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td><strong>@user.Username</strong></td>
                            <td>@user.Email</td>
                            <td>@user.FirstName @user.LastName</td>
                            <td>
                                <span class="badge @user.RoleBadgeClass">
                                    @user.RoleName
                                </span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }
                            </td>
                            <td>@user.Created.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-primary dropdown-toggle" 
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear"></i> Rol
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item @(user.Role == 1 ? "active" : "")" 
                                               href="#" onclick="updateRole(@user.Id, 1); return false;">
                                                <i class="bi bi-person"></i> Customer
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(user.Role == 2 ? "active" : "")" 
                                               href="#" onclick="updateRole(@user.Id, 2); return false;">
                                                <i class="bi bi-person-badge"></i> Manager
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(user.Role == 3 ? "active" : "")" 
                                               href="#" onclick="updateRole(@user.Id, 3); return false;">
                                                <i class="bi bi-shield-lock"></i> Admin
                                            </a>
                                        </li>
                                    </ul>
                                    
                                    <button type="button" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")" 
                                            onclick="toggleActive(@user.Id)">
                                        <i class="bi bi-@(user.IsActive ? "x-circle" : "check-circle")"></i>
                                        @(user.IsActive ? "Pasif Yap" : "Aktif Yap")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <span class="badge bg-primary me-2">
                <i class="bi bi-person"></i> Customer: @Model.Count(u => u.Role == 1)
            </span>
            <span class="badge bg-warning text-dark me-2">
                <i class="bi bi-person-badge"></i> Manager: @Model.Count(u => u.Role == 2)
            </span>
            <span class="badge bg-danger me-2">
                <i class="bi bi-shield-lock"></i> Admin: @Model.Count(u => u.Role == 3)
            </span>
            <span class="badge bg-success me-2">
                <i class="bi bi-check-circle"></i> Aktif: @Model.Count(u => u.IsActive)
            </span>
            <span class="badge bg-secondary">
                <i class="bi bi-x-circle"></i> Pasif: @Model.Count(u => !u.IsActive)
            </span>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        function updateRole(userId, newRole) {
            const roleName = newRole === 1 ? 'Customer' : (newRole === 2 ? 'Manager' : 'Admin');
            
            Swal.fire({
                title: 'Emin misiniz?',
                text: `Kullanıcı rolü "${roleName}" olarak değiştirilecek.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Evet, değiştir!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("UpdateUserRole", "Admin")',
                        type: 'POST',
                        data: {
                            userId: userId,
                            role: newRole
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Başarılı!',
                                    text: response.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Hata!', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Hata!', 'Bir hata oluştu.', 'error');
                        }
                    });
                }
            });
        }

        function toggleActive(userId) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: 'Kullanıcının aktiflik durumu değiştirilecek.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Evet, değiştir!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ToggleUserActive", "Admin")',
                        type: 'POST',
                        data: {
                            userId: userId
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Başarılı!',
                                    text: response.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Hata!', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Hata!', 'Bir hata oluştu.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
