@model List<Product>

@{
    ViewData["Title"] = "Ürünler";
    var currentUserId = Context.Session.GetInt32("UserId");
    var currentUserRole = Context.Session.GetString("UserRole");
    var isAdmin = currentUserRole == "Admin";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-box"></i> Ürün Listesi
    </h2>

    <!-- Alert Mesajları -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Yeni Ürün Ekleme Butonu -->
    <a class="btn btn-primary mb-3" asp-action="CreateProduct">
        <i class="bi bi-plus-circle"></i> Yeni Ürün Ekle
    </a>

    <!-- Ürün Listesi Tablosu -->
    <div class="table-responsive">
        <table id="productsTable" class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Ürün Adı</th>
                    <th>Kodu</th>
                    <th>Fiyat</th>
                    <th>Resim</th>
                    <th>Oluşturan</th>
                    <th>Oluşturulma Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td><strong>@product.Name</strong></td>
                        <td>@product.Code</td>
                        <td>@product.Price.ToString("N2") ₺</td>
                        <td>
                            @if (!string.IsNullOrEmpty(product.Image))
                            {
                                <img src="@product.Image" alt="@product.Name" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted">Resim yok</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(product.CreatedByFullName))
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-person"></i> @product.CreatedByFullName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <small class="text-muted">
                                <i class="bi bi-calendar"></i> 
                                @(product.Created.Year > 2000 ? product.Created.ToString("dd.MM.yyyy") : "-")
                            </small>
                        </td>
                        <td>
                            @{
                                var canEdit = isAdmin || (product.CreatedBy != null && product.CreatedBy == currentUserId);
                            }

                            @if (canEdit)
                            {
                                <div class="btn-group" role="group">
                                    <a class="btn btn-sm btn-warning" asp-action="UpdateProduct" asp-route-id="@product.Id">
                                        <i class="bi bi-pencil"></i> Düzenle
                                    </a>
                                    <a class="btn btn-sm btn-danger" asp-action="DeleteProduct" asp-route-id="@product.Id"
                                       onclick="return confirm('Bu ürünü silmek istediğinizden emin misiniz?')">
                                        <i class="bi bi-trash"></i> Sil
                                    </a>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-lock"></i> Yetkiniz Yok
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#productsTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json"
                },
                "order": [[5, "desc"]], // Oluşturulma tarihine göre azalan sıralama
                "pageLength": 10,
                "columnDefs": [
                    {
                        "targets": 6, // İşlemler kolonu
                        "orderable": false,
                        "searchable": false
                    },
                    {
                        "targets": 3, // Resim kolonu
                        "orderable": false
                    }
                ]
            });
        });
    </script>
}
