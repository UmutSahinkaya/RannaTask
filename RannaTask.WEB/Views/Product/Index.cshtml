@model List<Product>

@{
    ViewData["Title"] = "Ürünler";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-box"></i> Ürün Listesi
    </h2>

    <!-- Alert Mesajları -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Yeni Ürün Ekleme Butonu -->
    <a class="btn btn-primary mb-3" asp-action="CreateProduct">
        <i class="bi bi-plus-circle"></i> Yeni Ürün Ekle
    </a>

    <!-- Ürün Listesi Tablosu -->
    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Ürün Adı</th>
                    <th>Kodu</th>
                    <th>Fiyat</th>
                    <th>Resim</th>
                    <th>Oluşturan</th>
                    <th>Oluşturulma Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td><strong>@product.Name</strong></td>
                        <td>@product.Code</td>
                        <td>@product.Price.ToString("C2")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(product.Image))
                            {
                                <img src="@product.Image" alt="@product.Name" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted">Resim yok</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(product.CreatedByFullName))
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-person"></i> @product.CreatedByFullName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <small class="text-muted">
                                <i class="bi bi-calendar"></i> 
                                @(product.Created.Year > 2000 ? product.Created.ToString("dd.MM.yyyy") : "-")
                            </small>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a class="btn btn-sm btn-warning" asp-action="UpdateProduct" asp-route-id="@product.Id">
                                    <i class="bi bi-pencil"></i> Düzenle
                                </a>
                                <a class="btn btn-sm btn-danger" asp-action="DeleteProduct" asp-route-id="@product.Id"
                                   onclick="return confirm('Bu ürünü silmek istediğinizden emin misiniz?')">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
