{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=RannaTaskdb;User Id=sa;Password=YOUR_SQL_PASSWORD_HERE;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "JwtTokenOptions": {
    "Key": "CHANGE_THIS_TO_YOUR_SUPER_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "RannaTaskAPI",
    "Audience": "RannaTaskClients",
    "DurationInMinutes": 60
  }
}
