@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container mt-4">
    <h2><i class="bi bi-speedometer2"></i> Admin Paneli</h2>
    <hr />

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-people"></i> Kullanıcı Yönetimi
                    </h5>
                    <p class="card-text">Kullanıcıları görüntüle, rol ata, aktif/pasif yap</p>
                    <a asp-action="Users" class="btn btn-light">Yönet</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-headset"></i> Destek Talepleri
                    </h5>
                    <p class="card-text">Destek taleplerini yönet, yanıtla, kapat</p>
                    <a asp-action="SupportForms" class="btn btn-light">Yönet</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-box"></i> Ürünler
                    </h5>
                    <p class="card-text">Tüm ürünleri görüntüle ve yönet</p>
                    <a href="/product/Index" class="btn btn-light">Yönet</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
