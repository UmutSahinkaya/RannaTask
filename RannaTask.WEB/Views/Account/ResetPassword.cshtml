@model RannaTask.WEB.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3><i class="bi bi-shield-lock"></i> Şifre Sıfırla</h3>
                </div>
                <div class="card-body">
                    @if (TempData["ResetCode"] != null)
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>Şifre Sıfırlama Kodunuz:</strong> @TempData["ResetCode"]<br />
                            <small>(Gerçek uygulamada bu kod email'inize gönderilir)</small>
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Email" />

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="text" class="form-control" value="@Model.Email" disabled />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ResetCode" class="form-label">Sıfırlama Kodu</label>
                            <input asp-for="ResetCode" class="form-control" placeholder="6 haneli kod" maxlength="6" />
                            <span asp-validation-for="ResetCode" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
                            <input asp-for="NewPassword" class="form-control" placeholder="En az 6 karakter" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrar</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar girin" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Şifreyi Değiştir
                            </button>
                            <a asp-action="Login" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Girişe Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
